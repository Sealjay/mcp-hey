{
  "name": "mcp-hey",
  "version": "0.4.2",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Chris Lloyd-Jones",
    "url": "https://sealjay.com"
  },
  "description": "A local MCP server providing Claude with read/write access to Hey.com email accounts via reverse-engineered web APIs.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "test": "bun test",
    "lint": "bunx --bun biome check .",
    "lint:file": "bunx --bun biome check",
    "format": "bunx --bun biome check --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "node-html-parser": "6.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.6"
  }
}
